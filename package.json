{
  "name": "futari-labs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tools",
    "format": "biome check --write src tools",
    "assets:build": "node tools/assets/build.ts",
    "capture": "node tools/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "gsap": "3.15.1",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "meshoptimizer": "1.3.0",
    "opentype.js": "^2.0.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
